{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roxy-proxy.github.io/roxy-proxy/spec/node-protocol/v1/error.json",
  "title": "Error",
  "description": "Body of every non-2xx, non-304 response.",
  "type": "object",
  "required": ["error", "message"],
  "properties": {
    "error": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "message": {"type": "string"},
    "missing": {
      "type": "array",
      "description": "On 426: the features or protocol version the node lacks.",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1
    }
  },
  "if": {"properties": {"error": {"const": "unsupported"}}},
  "then": {"required": ["missing"]}
}
