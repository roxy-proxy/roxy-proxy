{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roxy-proxy.github.io/roxy-proxy/spec/node-protocol/v1/enrol-response.json",
  "title": "Enrol or renew response",
  "description": "200 body of POST /roxy/v1/enrol and POST /roxy/v1/renew.",
  "type": "object",
  "required": ["node_id", "certificate_chain", "not_after", "renew_after_seconds"],
  "properties": {
    "node_id": {"$ref": "#/$defs/node_id"},
    "certificate_chain": {
      "type": "string",
      "description": "PEM: the node certificate first, then intermediates. The node certificate's only SAN is the URI urn:roxy:node:<node_id>.",
      "pattern": "^-----BEGIN CERTIFICATE-----[\\s\\S]+-----END CERTIFICATE-----\\s*$"
    },
    "not_after": {
      "type": "string",
      "format": "date-time",
      "description": "The certificate's expiry, RFC 3339 in UTC."
    },
    "renew_after_seconds": {
      "type": "integer",
      "minimum": 1,
      "description": "Seconds after receipt at which the node renews."
    }
  },
  "$defs": {
    "node_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"}
  }
}
