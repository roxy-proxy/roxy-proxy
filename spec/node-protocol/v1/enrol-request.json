{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roxy-proxy.github.io/roxy-proxy/spec/node-protocol/v1/enrol-request.json",
  "title": "Enrol or renew request",
  "description": "Body of POST /roxy/v1/enrol and POST /roxy/v1/renew.",
  "type": "object",
  "required": ["csr", "roxy_version", "protocol_version", "features"],
  "properties": {
    "csr": {
      "type": "string",
      "description": "PEM CERTIFICATE REQUEST for an ECDSA P-256 or Ed25519 key, signed by that key.",
      "pattern": "^-----BEGIN CERTIFICATE REQUEST-----[\\s\\S]+-----END CERTIFICATE REQUEST-----\\s*$"
    },
    "roxy_version": {"type": "string", "minLength": 1},
    "protocol_version": {"type": "integer", "const": 1},
    "features": {"$ref": "#/$defs/features"}
  },
  "$defs": {
    "features": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  }
}
