{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roxy-proxy.github.io/roxy-proxy/spec/node-protocol/v1/lease.json",
  "title": "Lease",
  "description": "200 body of GET /roxy/v1/lease.",
  "type": "object",
  "required": [
    "lease_id", "issued_at", "valid_for_seconds", "refresh_after_seconds",
    "config", "config_hash", "secrets", "secrets_hash", "state_epoch", "flow"
  ],
  "properties": {
    "lease_id": {"type": "string", "minLength": 1},
    "issued_at": {"type": "string", "format": "date-time"},
    "valid_for_seconds": {"type": "integer", "minimum": 1},
    "refresh_after_seconds": {"type": "integer", "minimum": 1},
    "config": {"type": "string", "description": "A complete roxy.yaml with no secret values."},
    "config_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "SHA-256 of the UTF-8 bytes of config."
    },
    "secrets": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/secret_value"}
    },
    "secrets_hash": {"type": "string", "minLength": 1},
    "state_epoch": {"type": "string", "minLength": 1},
    "flow": {"$ref": "#/$defs/flow"},
    "interception_ca": {
      "description": "Reserved. A v1 server must not send it.",
      "not": {}
    }
  },
  "$defs": {
    "secret_value": {
      "oneOf": [
        {"type": "string"},
        {
          "type": "object",
          "required": ["b64"],
          "additionalProperties": false,
          "properties": {
            "b64": {"type": "string", "pattern": "^[A-Za-z0-9+/]*={0,2}$"}
          }
        }
      ]
    },
    "flow": {
      "type": "object",
      "required": [
        "ship", "batch_max_bytes", "batch_max_events", "flush_interval_seconds",
        "spool_high_water_bytes", "on_high_water"
      ],
      "properties": {
        "ship": {"type": "boolean"},
        "batch_max_bytes": {"type": "integer", "minimum": 1},
        "batch_max_events": {"type": "integer", "minimum": 1},
        "flush_interval_seconds": {"type": "integer", "minimum": 1},
        "spool_high_water_bytes": {"type": "integer", "minimum": 0},
        "on_high_water": {"type": "string", "enum": ["hold", "spool"]}
      }
    }
  }
}
